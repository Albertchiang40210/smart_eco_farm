# 複製為 .env 後填入實際值：cp .env.example .env
# 產生金鑰： python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- MySQL ---
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=smart_eco_farm_db

# --- Redis ---
REDIS_HOST=localhost

# --- 認證 ---
SECRET_KEY=change_me_to_a_long_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
# IoT 感測器 / 手機巡檢端使用的 API Key（放在 X-API-Key header）
DEVICE_API_KEY=change_me_device_key

# --- CORS（逗號分隔）---
CORS_ORIGINS=http://localhost:3000

# --- Telegram 警報（選填；向 @BotFather 申請 bot）---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
